<Window x:Class="AudioPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:c="clr-namespace:AudioPlayer.App.Controls"
        Title="{Binding WindowTitle}" Height="720" Width="1280" MinWidth="900" MinHeight="560"
        WindowState="Maximized" Background="{StaticResource Ap.Bg}" Foreground="{StaticResource Ap.Text}">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="New_Executed"/>
        <CommandBinding Command="Open" Executed="Open_Executed"/>
        <CommandBinding Command="Save" Executed="Save_Executed"/>
        <CommandBinding Command="SaveAs" Executed="SaveAs_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <!-- Click, then press a key combination to assign it (Backspace clears, Esc cancels) -->
        <Style x:Key="KeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ap.SubText}"/>
            <Setter Property="ToolTip" Value="Shortcut: klik lalu tekan tombol. Backspace = hapus, Esc = batal."/>
            <EventSetter Event="PreviewKeyDown" Handler="ShortcutBox_PreviewKeyDown"/>
        </Style>
        <!-- Fade value label: grey italic while the track follows the project default (Tag = IsDefault) -->
        <Style x:Key="FadeLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Ap.SubText}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="ToolTip" Value="Kembali ke default dari Settings"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Toolbar: file actions left, PANIC always visible right ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Ap.Panel}" BorderBrush="{StaticResource Ap.Line}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,18,0"
                               MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    <Button Command="New" Content="Baru" Style="{StaticResource Ap.ToolButton}" ToolTip="Project baru (Ctrl+N)"/>
                    <Button Command="Open" Content="Buka" Style="{StaticResource Ap.ToolButton}" ToolTip="Buka project (Ctrl+O)"/>
                    <Button Command="Save" Content="Simpan" Style="{StaticResource Ap.ToolButton}" ToolTip="Simpan project (Ctrl+S)"/>
                    <Button Command="SaveAs" Content="Simpan sebagai" Style="{StaticResource Ap.ToolButton}"/>
                    <Rectangle Width="1" Height="22" Fill="{StaticResource Ap.Line}" Margin="6,0,12,0"/>
                    <Button Click="AddFiles_Click" Content="＋ Track" Style="{StaticResource Ap.ToolButton}" ToolTip="Tambah file audio"/>
                    <Button Click="AddFolder_Click" Content="＋ Folder" Style="{StaticResource Ap.ToolButton}" ToolTip="Tambah semua audio dalam folder"/>
                    <Rectangle Width="1" Height="22" Fill="{StaticResource Ap.Line}" Margin="6,0,12,0"/>
                    <Button Click="Settings_Click" Content="⚙ Settings" Style="{StaticResource Ap.ToolButton}"/>
                    <Button Click="ResetLayout_Click" Content="Reset layout" Style="{StaticResource Ap.ToolButton}" ToolTip="Kembalikan susunan panel ke default"/>
                </WrapPanel>
                <Button Grid.Column="1" Content="PANIC" Command="{Binding PanicCommand}" Style="{StaticResource Ap.Danger}"
                        ToolTip="Stop semua track Main &amp; Monitor seketika" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Alert banner (device lost etc.) ===== -->
        <Border DockPanel.Dock="Top" Background="#8E1B1B" Padding="10,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Alert}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tutup" Command="{Binding DismissAlertCommand}" Style="{StaticResource Ap.ToolButton}" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Pakai device default (Main)" Command="{Binding UseDefaultForMainCommand}" Style="{StaticResource Ap.ToolButton}"/>
                <TextBlock Text="{Binding Alert}" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ===== Status bar: save, autosave, devices. Wraps instead of cutting when narrow ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Ap.Panel}" BorderBrush="{StaticResource Ap.Line}" BorderThickness="0,1,0,0" Padding="8,4">
            <WrapPanel>
                <Border CornerRadius="4" Padding="8,2" Margin="0,2,10,2" ToolTip="Status penyimpanan project">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1F3D2A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Background" Value="#4A3A10"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SaveStateText}"/>
                </Border>
                <TextBlock Text="{Binding AutosaveText}" Style="{StaticResource Ap.Caption}" Margin="0,2,16,2"/>

                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" ToolTip="Output device MAIN">
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Ap.Err}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MainDeviceOk}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ap.Ok}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="MAIN: " Foreground="{StaticResource Ap.Main}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MainDeviceText}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,16,2" ToolTip="Output device MONITOR">
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Ap.Warn}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MonitorDeviceOk}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ap.Ok}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="MONITOR: " Foreground="{StaticResource Ap.Cue}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MonitorDeviceText}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Ap.Caption}" Margin="0,2,16,2">
                    <Run Text="Total playlist "/><Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource Ap.Text}"/>
                </TextBlock>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ap.Warn}" Margin="0,2" MaxWidth="600" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}"/>
            </WrapPanel>
        </Border>

        <!-- ===== Dockable panels: drag a tab to move/float/stack; layout is remembered ===== -->
        <ad:DockingManager x:Name="Dock">
            <ad:DockingManager.Theme>
                <adt:Vs2013DarkTheme/>
            </ad:DockingManager.Theme>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Vertical">
                    <ad:LayoutPanel Orientation="Horizontal" DockHeight="2*" DockMinHeight="220">
                        <ad:LayoutAnchorablePane DockWidth="5*" DockMinWidth="420">
                            <ad:LayoutAnchorable Title="Track List" ContentId="tracks" CanClose="False" CanHide="False">
                                <!-- ===== Track list + welcome screen ===== -->
                                <Grid x:Name="TracksPanel" Background="{StaticResource Ap.Bg}">
                                    <ListView x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding Selected}"
                                              Background="Transparent" BorderThickness="0">
                                        <ListView.ItemContainerStyle>
                                            <!-- Must derive from the GridView row style, or rows render as plain text instead of columns -->
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MainState}" Value="Playing">
                                                        <Setter Property="Background" Value="{StaticResource Ap.RowPlaying}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MainState}" Value="Paused">
                                                        <Setter Property="Background" Value="{StaticResource Ap.RowPaused}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Ap.Err}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Naik" Command="{Binding MoveUpCommand}"/>
                                                <MenuItem Header="Turun" Command="{Binding MoveDownCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Hapus dari list" Command="{Binding RemoveCommand}"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="40"/>
                                                <GridViewColumn Header="Judul" DisplayMemberBinding="{Binding Title}" Width="230"/>
                                                <GridViewColumn Header="Durasi" DisplayMemberBinding="{Binding DurationText}" Width="70"/>
                                                <GridViewColumn Header="Sisa" DisplayMemberBinding="{Binding RemainingText}" Width="70"/>
                                                <GridViewColumn Header="Transport" Width="190">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="{Binding PreviewLabel}" Width="64" Focusable="False" ToolTip="Preview di Monitor"
                                                                        Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="{Binding PlayLabel}" Width="44" Margin="4,0" Focusable="False" ToolTip="Play/Pause di Main"
                                                                        Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Content="■" Width="44" Focusable="False" ToolTip="Stop Main"
                                                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Loop" Width="56">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate><CheckBox IsChecked="{Binding Loop}" Focusable="False" MinWidth="0"/></DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Overlay" Width="70">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate><CheckBox IsChecked="{Binding Overlay}" Focusable="False" MinWidth="0" ToolTip="Main di atas track lain tanpa menghentikannya (jingle/SFX)"/></DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Fade in" Width="170">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" ToolTip="Fade-in. Abu-abu miring = memakai default dari Settings; ↺ = kembali ke default.">
                                                                <Slider Style="{StaticResource Ap.FadeSlider}" Value="{Binding FadeInSeconds}"/>
                                                                <TextBlock Text="{Binding FadeInSeconds, StringFormat={}{0:0.0} s}" Tag="{Binding FadeInIsDefault}" Style="{StaticResource FadeLabel}"/>
                                                                <Button Content="↺" Command="{Binding ResetFadeInCommand}" Style="{StaticResource ResetButton}"
                                                                        Visibility="{Binding FadeInIsDefault, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Fade out" Width="170">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" ToolTip="Fade-out (stop, pause, dan menjelang end point). Abu-abu miring = default; ↺ = kembali ke default.">
                                                                <Slider Style="{StaticResource Ap.FadeSlider}" Value="{Binding FadeOutSeconds}"/>
                                                                <TextBlock Text="{Binding FadeOutSeconds, StringFormat={}{0:0.0} s}" Tag="{Binding FadeOutIsDefault}" Style="{StaticResource FadeLabel}"/>
                                                                <Button Content="↺" Command="{Binding ResetFadeOutCommand}" Style="{StaticResource ResetButton}"
                                                                        Visibility="{Binding FadeOutIsDefault, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Shortcut" Width="170">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox Text="{Binding Shortcut, UpdateSourceTrigger=Explicit}" Style="{StaticResource KeyBox}" Width="104" Margin="0"
                                                                         ToolTip="Klik lalu tekan tombol untuk memutar track ini di Main. Backspace = hapus, Esc = batal."/>
                                                                <CheckBox IsChecked="{Binding ShortcutGlobal}" Content="G" Margin="6,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                                                          Focusable="False" ToolTip="Global: aktif walau jendela tidak fokus"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Volume" Width="200">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Slider Style="{StaticResource Ap.FaderH}" Width="130" Value="{Binding VolumeDb}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding VolumeDb, StringFormat={}{0:0.0} dB}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <!-- Welcome screen: covers the list while it is empty -->
                                    <Border Background="{StaticResource Ap.Bg}" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel MaxWidth="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Audio Player" FontSize="32" FontWeight="SemiBold"/>
                                            <TextBlock Text="Mulai dengan menambahkan track, atau buka project yang sudah disimpan."
                                                       Style="{StaticResource Ap.Caption}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                                            <WrapPanel Margin="0,0,0,28">
                                                <Button x:Name="WelcomeAddFiles" Click="AddFiles_Click" Padding="16,12" Margin="0,0,10,10" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock Text="＋ Tambah track" FontWeight="SemiBold" FontSize="15"/>
                                                        <TextBlock Text="Pilih file audio" Style="{StaticResource Ap.Caption}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="AddFolder_Click" Padding="16,12" Margin="0,0,10,10" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock Text="＋ Tambah folder" FontWeight="SemiBold" FontSize="15"/>
                                                        <TextBlock Text="Semua audio di folder" Style="{StaticResource Ap.Caption}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="Open" Padding="16,12" Margin="0,0,10,10" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock Text="Buka project" FontWeight="SemiBold" FontSize="15"/>
                                                        <TextBlock Text="File .approj (Ctrl+O)" Style="{StaticResource Ap.Caption}"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock Text="Project terakhir" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="NoRecent" Text="Belum ada project yang disimpan." Style="{StaticResource Ap.Caption}"/>
                                            <ItemsControl x:Name="RecentList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="OpenRecent_Click" Tag="{Binding Path}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Background="Transparent" BorderThickness="0" Padding="8,6" Margin="0,0,0,2" Cursor="Hand" ToolTip="{Binding Path}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Ap.Cue}"/>
                                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Ap.Caption}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    </Border>
                                </Grid>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutAnchorablePane DockWidth="1*" DockMinWidth="170">
                            <ad:LayoutAnchorable Title="Master" ContentId="master" CanClose="False" CanHide="False">
                                <!-- ===== Master faders ===== -->
                                <!-- No horizontal scrolling: long device names are trimmed instead of pushing a fader out of view -->
                                <ScrollViewer x:Name="MasterPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Ap.Bg}">
                                    <Grid Margin="10" MinHeight="320">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <!-- Output routing, switchable live: changing one bus never interrupts the other -->
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Output MAIN" Foreground="{StaticResource Ap.Main}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <ComboBox ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding MainOutputId}" DropDownOpened="Outputs_DropDownOpened"
                                                      HorizontalAlignment="Stretch" Focusable="False" ToolTip="Device yang didengar audiens"/>
                                            <TextBlock Text="Output MONITOR" Foreground="{StaticResource Ap.Cue}" FontWeight="SemiBold" Margin="0,10,0,3"/>
                                            <ComboBox ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding MonitorOutputId}" DropDownOpened="Outputs_DropDownOpened"
                                                      HorizontalAlignment="Stretch" Focusable="False" ToolTip="Device preview/cue untuk operator (headphone)"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource Ap.Chip}" Background="{StaticResource Ap.Main}" HorizontalAlignment="Center">
                                                    <TextBlock Text="MAIN" Style="{StaticResource Ap.ChipText}"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MainVolumeDb, StringFormat={}{0:0.0} dB}" HorizontalAlignment="Center"
                                                           FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                <Slider Style="{StaticResource Ap.FaderV}" Value="{Binding MainVolumeDb}" Foreground="{StaticResource Ap.Main}"
                                                        HorizontalAlignment="Center" Margin="0,8" MinHeight="140" ToolTip="Master volume MAIN"/>
                                            </DockPanel>
                                            <DockPanel Grid.Column="1">
                                                <Border DockPanel.Dock="Top" Style="{StaticResource Ap.Chip}" Background="{StaticResource Ap.Cue}" HorizontalAlignment="Center">
                                                    <TextBlock Text="MONITOR" Style="{StaticResource Ap.ChipText}"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MonitorVolumeDb, StringFormat={}{0:0.0} dB}" HorizontalAlignment="Center"
                                                           FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                <Slider Style="{StaticResource Ap.FaderV}" Value="{Binding MonitorVolumeDb}" Foreground="{StaticResource Ap.Cue}"
                                                        HorizontalAlignment="Center" Margin="0,8" MinHeight="140" ToolTip="Master volume MONITOR"/>
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>

                    <ad:LayoutPanel Orientation="Horizontal" DockHeight="1*" DockMinHeight="170">
                        <ad:LayoutAnchorablePane DockWidth="3*" DockMinWidth="280">
                            <ad:LayoutAnchorable Title="Transport MAIN" ContentId="main" CanClose="False" CanHide="False">
                                <!-- ===== MAIN transport: what the audience hears ===== -->
                                <ScrollViewer x:Name="MainPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Ap.Bg}">
                                    <StackPanel Margin="14,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Ap.Chip}" Background="{StaticResource Ap.Main}" Margin="0,0,10,0">
                                                <TextBlock Text="MAIN" Style="{StaticResource Ap.ChipText}"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MainBar.RemainingText}" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource Ap.Main}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MainBar.Title}" Style="{StaticResource PanelTitle}" FontSize="20"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding MainBar.ElapsedText}" Style="{StaticResource Ap.Caption}" Width="48" Margin="0,12,0,0"/>
                                            <c:SeekBarView Accent="{StaticResource Ap.Main}" Height="52"
                                                           Duration="{Binding MainBar.Duration}" Position="{Binding MainBar.Position}" IsScrubbing="{Binding MainBar.IsDragging}" IsEditingRange="{Binding MainBar.IsEditingRange}"
                                                           IsEnabled="{Binding MainBar.HasTrack}" RangeStart="{Binding MainBar.RangeStart}" RangeEnd="{Binding MainBar.RangeEnd}"
                                                           FadeIn="{Binding MainBar.FadeIn}" FadeOut="{Binding MainBar.FadeOut}" ShowFadeOut="{Binding MainBar.ShowFadeOut}"
                                                           Curve="{Binding MainBar.Curve}" ToolTip="Klik/geser untuk pindah posisi di Main"/>
                                        </DockPanel>
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                                <Button Content="{Binding MainBar.PlayLabel}" Command="{Binding MainPlayPauseCommand}" Style="{StaticResource TransportButton}" ToolTip="Play/Pause Main"/>
                                                <TextBox Text="{Binding MainPlayPauseKey, UpdateSourceTrigger=Explicit}" Style="{StaticResource KeyBox}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                                <Button Content="■" Command="{Binding MainStopCommand}" Style="{StaticResource TransportButton}" ToolTip="Stop Main (dengan fade)"/>
                                                <TextBox Text="{Binding MainStopKey, UpdateSourceTrigger=Explicit}" Style="{StaticResource KeyBox}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutAnchorablePane DockWidth="3*" DockMinWidth="280">
                            <ad:LayoutAnchorable Title="Cue / Preview" ContentId="cue" CanClose="False" CanHide="False">
                                <!-- ===== CUE: preview on Monitor + start/end points ===== -->
                                <ScrollViewer x:Name="CuePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Ap.Bg}">
                                    <StackPanel Margin="14,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource Ap.Chip}" Background="{StaticResource Ap.Cue}" Margin="0,0,10,0">
                                                <TextBlock Text="CUE" Style="{StaticResource Ap.ChipText}"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CueBar.RemainingText}" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ap.Cue}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CueBar.Title}" Style="{StaticResource PanelTitle}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding CueBar.ElapsedText}" Style="{StaticResource Ap.Caption}" Width="48" Margin="0,12,0,0"/>
                                            <c:SeekBarView Accent="{StaticResource Ap.Cue}" Height="52"
                                                           Duration="{Binding CueBar.Duration}" Position="{Binding CueBar.Position}" IsScrubbing="{Binding CueBar.IsDragging}" IsEditingRange="{Binding CueBar.IsEditingRange}"
                                                           IsEnabled="{Binding CueBar.HasTrack}" RangeStart="{Binding CueBar.RangeStart}" RangeEnd="{Binding CueBar.RangeEnd}"
                                                           FadeIn="{Binding CueBar.FadeIn}" FadeOut="{Binding CueBar.FadeOut}" ShowFadeOut="{Binding CueBar.ShowFadeOut}"
                                                           Curve="{Binding CueBar.Curve}" ToolTip="Klik/geser untuk pindah posisi preview atau memilih titik start/end"/>
                                        </DockPanel>
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                                <Button Content="{Binding CueBar.PlayLabel}" Command="{Binding CuePlayPauseCommand}" Style="{StaticResource TransportButton}"
                                                        ToolTip="Play/Pause preview di Monitor (mulai dari posisi slider CUE)"/>
                                                <TextBox Text="{Binding CuePlayPauseKey, UpdateSourceTrigger=Explicit}" Style="{StaticResource KeyBox}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,18,0">
                                                <Button Content="■" Command="{Binding CueStopCommand}" Style="{StaticResource TransportButton}" ToolTip="Stop preview"/>
                                                <TextBox Text="{Binding CueStopKey, UpdateSourceTrigger=Explicit}" Style="{StaticResource KeyBox}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding CueBar.HasTrack}">
                                                <Button Content="⇤ Set start" Command="{Binding SetStartCommand}" Style="{StaticResource Ap.ToolButton}" ToolTip="Jadikan posisi slider CUE sebagai titik mulai"/>
                                                <Button Content="Set end ⇥" Command="{Binding SetEndCommand}" Style="{StaticResource Ap.ToolButton}" ToolTip="Jadikan posisi slider CUE sebagai titik akhir"/>
                                                <Button Content="Reset" Command="{Binding ResetRangeCommand}" Style="{StaticResource Ap.ToolButton}" ToolTip="Putar dari awal sampai akhir file"/>
                                                <TextBlock Text="{Binding CueBar.RangeText}" Foreground="{StaticResource Ap.Cue}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutAnchorablePane DockWidth="2*" DockMinWidth="220">
                            <ad:LayoutAnchorable Title="Aktivitas" ContentId="activity" CanClose="False" CanHide="False">
                                <!-- ===== Activity log: saves, autosaves, device events, errors ===== -->
                                <ListBox x:Name="ActivityPanel" ItemsSource="{Binding Activity}" Background="{StaticResource Ap.Bg}" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Style="{StaticResource Ap.Caption}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                                    <Setter Property="Foreground" Value="{StaticResource Ap.Ok}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{StaticResource Ap.Warn}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource Ap.Err}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
