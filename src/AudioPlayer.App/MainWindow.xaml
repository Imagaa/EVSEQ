<Window x:Class="AudioPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="640" Width="1420">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="New_Executed"/>
        <CommandBinding Command="Open" Executed="Open_Executed"/>
        <CommandBinding Command="Save" Executed="Save_Executed"/>
        <CommandBinding Command="SaveAs" Executed="SaveAs_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Grey default value shown inside an empty fade box (the TextBox sibling is named "Box") -->
        <Style x:Key="DefaultHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="5,1,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=Box}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" x:Name="FileMenu">
                <MenuItem Command="New" Header="_Baru"/>
                <MenuItem Command="Open" Header="_Buka..."/>
                <MenuItem Command="Save" Header="_Simpan"/>
                <MenuItem Command="SaveAs" Header="Simpan _sebagai..."/>
                <Separator/>
                <MenuItem Header="_Tambah file audio..." Click="AddFiles_Click"/>
                <MenuItem Header="Tambah _folder audio..." Click="AddFolder_Click"/>
                <Separator/>
                <MenuItem Header="_Keluar" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings..." Click="Settings_Click"/>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#B71C1C" Padding="10,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Alert}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tutup" Command="{Binding DismissAlertCommand}" Focusable="False" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Pakai device default (Main)" Command="{Binding UseDefaultForMainCommand}" Focusable="False"/>
                <TextBlock Text="{Binding Alert}" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Master faders: large and color-coded so they are easy to tell apart live -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8">
            <StackPanel Margin="6,0">
                <TextBlock Text="MAIN" FontWeight="Bold" Foreground="White" Background="#C62828" Padding="8,2" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Height="320" Minimum="-60" Maximum="0" SmallChange="0.5" LargeChange="3"
                        Value="{Binding MainVolumeDb}" HorizontalAlignment="Center" Margin="0,6" Focusable="False"/>
                <TextBlock Text="{Binding MainVolumeDb, StringFormat={}{0:0.0} dB}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="6,0">
                <TextBlock Text="MONITOR" FontWeight="Bold" Foreground="White" Background="#1565C0" Padding="8,2" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Height="320" Minimum="-60" Maximum="0" SmallChange="0.5" LargeChange="3"
                        Value="{Binding MonitorVolumeDb}" HorizontalAlignment="Center" Margin="0,6" Focusable="False"/>
                <TextBlock Text="{Binding MonitorVolumeDb, StringFormat={}{0:0.0} dB}" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,6,8,8">
            <!-- MAIN seek bar: the track the audience hears -->
            <Grid DataContext="{Binding MainBar}" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="MAIN" FontWeight="Bold" Foreground="White" Background="#C62828" Padding="8,3" TextAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" FontSize="14" VerticalAlignment="Center"/>
                <Slider Grid.Column="3" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" IsEnabled="{Binding HasTrack}"
                        IsMoveToPointEnabled="True" IsSelectionRangeEnabled="True" SelectionStart="{Binding RangeStart}" SelectionEnd="{Binding RangeEnd}"
                        Tag="{Binding}" Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                        Focusable="False" VerticalAlignment="Center" ToolTip="Klik/geser untuk pindah posisi di Main"/>
                <TextBlock Grid.Column="4" Text="{Binding RemainingText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- CUE seek bar: preview on Monitor, and where start/end points are set -->
            <Grid DataContext="{Binding CueBar}" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CUE" FontWeight="Bold" Foreground="White" Background="#1565C0" Padding="8,3" TextAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" VerticalAlignment="Center"/>
                <Slider Grid.Column="3" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" IsEnabled="{Binding HasTrack}"
                        IsMoveToPointEnabled="True" IsSelectionRangeEnabled="True" SelectionStart="{Binding RangeStart}" SelectionEnd="{Binding RangeEnd}"
                        Tag="{Binding}" Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                        Focusable="False" VerticalAlignment="Center" ToolTip="Klik/geser untuk pindah posisi preview atau memilih titik start/end"/>
                <TextBlock Grid.Column="4" Text="{Binding RemainingText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CueBar.HasTrack}">
                    <Button Content="⇤ Set start" Command="{Binding SetStartCommand}" Focusable="False" Padding="8,2" ToolTip="Jadikan posisi slider CUE sebagai titik mulai"/>
                    <Button Content="Set end ⇥" Command="{Binding SetEndCommand}" Focusable="False" Padding="8,2" Margin="4,0" ToolTip="Jadikan posisi slider CUE sebagai titik akhir"/>
                    <Button Content="Reset" Command="{Binding ResetRangeCommand}" Focusable="False" Padding="8,2" ToolTip="Putar dari awal sampai akhir file"/>
                    <TextBlock Text="{Binding CueBar.RangeText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#1565C0" Width="110"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="14">
                    <Run Text="Total: "/><Run Text="{Binding TotalText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Margin="16,0" Text="{Binding Status}" Foreground="#B71C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="PANIC" Command="{Binding PanicCommand}" Focusable="False"
                        Background="#B71C1C" Foreground="White" FontWeight="Bold" FontSize="18" Padding="24,10"
                        ToolTip="Stop semua track Main &amp; Monitor seketika"/>
            </Grid>
        </StackPanel>

        <Grid>
        <ListView x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding Selected}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MainState}" Value="Playing">
                            <Setter Property="Background" Value="#C8E6C9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MainState}" Value="Paused">
                            <Setter Property="Background" Value="#FFF9C4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Naik" Command="{Binding MoveUpCommand}"/>
                    <MenuItem Header="Turun" Command="{Binding MoveDownCommand}"/>
                    <Separator/>
                    <MenuItem Header="Hapus dari list" Command="{Binding RemoveCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" DisplayMemberBinding="{Binding Number}" Width="36"/>
                    <GridViewColumn Header="Judul" DisplayMemberBinding="{Binding Title}" Width="240"/>
                    <GridViewColumn Header="Durasi" DisplayMemberBinding="{Binding DurationText}" Width="70"/>
                    <GridViewColumn Header="Sisa" DisplayMemberBinding="{Binding RemainingText}" Width="70"/>
                    <GridViewColumn Header="Transport" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding PreviewLabel}" Width="56" Focusable="False" ToolTip="Preview di Monitor"
                                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{Binding PlayLabel}" Width="40" Margin="4,0" Focusable="False" ToolTip="Play/Pause di Main"
                                            Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="■" Width="40" Focusable="False" ToolTip="Stop Main"
                                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Loop" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding Loop}" Focusable="False"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Overlay" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding Overlay}" Focusable="False" ToolTip="Main di atas track lain tanpa menghentikannya (jingle/SFX)"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Fade in (s)" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ToolTip="Fade-in dalam detik, mis. 0.5. Kosongkan untuk memakai default dari Settings.">
                                    <TextBox x:Name="Box" Text="{Binding FadeInText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="60"/>
                                    <TextBlock Text="{Binding DefaultFadeIn}" Style="{StaticResource DefaultHint}"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Fade out (s)" Width="85">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ToolTip="Fade-out dalam detik, mis. 2. Kosongkan untuk memakai default dari Settings.">
                                    <TextBox x:Name="Box" Text="{Binding FadeOutText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="60"/>
                                    <TextBlock Text="{Binding DefaultFadeOut}" Style="{StaticResource DefaultHint}"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Shortcut" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding Shortcut, Mode=OneWay}" Width="100" IsReadOnly="True"
                                             PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                                             ToolTip="Klik lalu tekan tombol untuk memutar track ini di Main. Backspace = hapus, Esc = batal."/>
                                    <CheckBox IsChecked="{Binding ShortcutGlobal}" Content="G" Margin="6,0,0,0" VerticalAlignment="Center"
                                              Focusable="False" ToolTip="Global: aktif walau jendela tidak fokus"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Volume" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Width="140" Minimum="-60" Maximum="0" SmallChange="0.5" Value="{Binding VolumeDb}" Focusable="False"/>
                                    <TextBlock Text="{Binding VolumeDb, StringFormat={}{0:0.0} dB}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Welcome screen: covers the list while it is empty -->
        <Border Background="White" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Audio Player" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Mulai dengan menambahkan track, atau buka project yang sudah disimpan." Foreground="Gray" Margin="0,4,0,20"/>

                <UniformGrid Columns="3" Margin="0,0,0,28">
                    <Button x:Name="WelcomeAddFiles" Click="AddFiles_Click" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="＋ Tambah track" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Pilih file audio" Foreground="Gray"/>
                        </StackPanel>
                    </Button>
                    <Button Click="AddFolder_Click" Padding="12" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="＋ Tambah folder" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Semua audio di folder" Foreground="Gray"/>
                        </StackPanel>
                    </Button>
                    <Button Command="Open" Padding="12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Buka project" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="File .approj (Ctrl+O)" Foreground="Gray"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock Text="Project terakhir" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoRecent" Text="Belum ada project yang disimpan." Foreground="Gray"/>
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OpenRecent_Click" Tag="{Binding Path}" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand" ToolTip="{Binding Path}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#1565C0"/>
                                    <TextBlock Text="{Binding Folder}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>
</Window>
