<Window x:Class="AudioPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Ap.Panel}" Foreground="{StaticResource Ap.Text}" Icon="/Assets/evseq.ico">
    <StackPanel Margin="16" Width="520">
        <TextBlock Text="Output device" FontWeight="Bold"/>
        <Grid Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="MAIN" Foreground="#C62828" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="MainDevice" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="MONITOR" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonitorDevice" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2"/>
        </Grid>

        <TextBlock Text="Fade default" FontWeight="Bold"/>
        <Grid Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Fade-in" VerticalAlignment="Center"/>
            <Slider x:Name="FadeIn" Grid.Column="1" Style="{StaticResource Ap.FadeSlider}" Width="Auto" Margin="0,4"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=FadeIn, StringFormat={}{0:0.0} s}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Fade-out" VerticalAlignment="Center"/>
            <Slider x:Name="FadeOut" Grid.Row="1" Grid.Column="1" Style="{StaticResource Ap.FadeSlider}" Width="Auto" Margin="0,4"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=FadeOut, StringFormat={}{0:0.0} s}" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Kurva" VerticalAlignment="Center"/>
            <ComboBox x:Name="Curve" Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,4"/>
        </Grid>

        <TextBlock Text="Shortcut" FontWeight="Bold"/>
        <TextBlock Foreground="Gray" Margin="0,2,0,4" TextWrapping="Wrap"
                   Text="Format: Ctrl+Alt+D1, Shift+F5, Space, F12. Angka ditulis D1..D9. Kosongkan Tombol untuk menonaktifkan. Track # hanya untuk PlayTrack. Global = aktif walau jendela tidak fokus."/>
        <DataGrid x:Name="Shortcuts" AutoGenerateColumns="False" Height="240" CanUserAddRows="True" CanUserDeleteRows="True">
            <DataGrid.Columns>
                <DataGridComboBoxColumn x:Name="ActionColumn" Header="Aksi" SelectedItemBinding="{Binding Action}" Width="170"/>
                <DataGridTextColumn Header="Tombol" Binding="{Binding Gesture}" Width="150"/>
                <DataGridTextColumn Header="Track #" Binding="{Binding TrackNumber, TargetNullValue=''}" Width="70"/>
                <DataGridCheckBoxColumn Header="Global" Binding="{Binding Global}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Updates: bound directly to the UpdateViewModel (applies immediately, not on OK) -->
        <StackPanel x:Name="UpdateSection" Margin="0,14,0,0">
            <TextBlock Text="Update" FontWeight="Bold"/>
            <CheckBox IsChecked="{Binding AutoUpdate}" Margin="0,6,0,0"
                      Content="Periksa &amp; unduh update otomatis (dipasang saat EVSEQ ditutup)"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Cek update sekarang" Command="{Binding CheckNowCommand}" Padding="10,3"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Ap.SubText}" TextWrapping="Wrap" Margin="0,0,8,0">
                    <Run Text="Versi terpasang: "/><Run Text="{Binding CurrentVersionText, Mode=OneWay}" Foreground="{StaticResource Ap.Text}"/>
                    <LineBreak/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Batal" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
