<Window x:Class="AudioPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Width="520">
        <TextBlock Text="Output device" FontWeight="Bold"/>
        <Grid Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="MAIN" Foreground="#C62828" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="MainDevice" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="MONITOR" Foreground="#1565C0" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonitorDevice" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,2"/>
        </Grid>

        <TextBlock Text="Fade default" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
            <TextBlock Text="Fade-in (ms)" VerticalAlignment="Center"/>
            <TextBox x:Name="FadeIn" Width="60" Margin="6,0,16,0"/>
            <TextBlock Text="Fade-out (ms)" VerticalAlignment="Center"/>
            <TextBox x:Name="FadeOut" Width="60" Margin="6,0,16,0"/>
            <TextBlock Text="Kurva" VerticalAlignment="Center"/>
            <ComboBox x:Name="Curve" Width="110" Margin="6,0,0,0"/>
        </StackPanel>

        <StackPanel x:Name="ShortcutsHost"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Batal" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
