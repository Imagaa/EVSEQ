<Application x:Class="AudioPlayer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AudioPlayer.App.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Built-in WPF Fluent theme, dark variant: styles every standard control -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- App palette (matches the AvalonDock VS2013 dark chrome) -->
            <SolidColorBrush x:Key="Ap.Bg" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="Ap.Panel" Color="#252526"/>
            <SolidColorBrush x:Key="Ap.PanelAlt" Color="#2D2D30"/>
            <SolidColorBrush x:Key="Ap.Line" Color="#3F3F46"/>
            <SolidColorBrush x:Key="Ap.Text" Color="#ECECEF"/>
            <SolidColorBrush x:Key="Ap.SubText" Color="#9C9CA6"/>
            <SolidColorBrush x:Key="Ap.Main" Color="#E5484D"/>
            <SolidColorBrush x:Key="Ap.Cue" Color="#3B8EEA"/>
            <SolidColorBrush x:Key="Ap.Ok" Color="#3FB950"/>
            <SolidColorBrush x:Key="Ap.Warn" Color="#D29922"/>
            <SolidColorBrush x:Key="Ap.Err" Color="#F85149"/>
            <SolidColorBrush x:Key="Ap.RowPlaying" Color="#1F3D2A"/>
            <SolidColorBrush x:Key="Ap.RowPaused" Color="#3D3419"/>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

            <!-- Small colored label: MAIN / CUE / MONITOR -->
            <Style x:Key="Ap.Chip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Ap.ChipText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="Ap.Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ap.SubText}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Buttons that must never steal keyboard focus from the track list -->
            <Style x:Key="Ap.ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Padding" Value="12,5"/>
            </Style>
            <!-- ===== Console-style faders. Foreground = fill color (MAIN red, MONITOR blue) ===== -->
            <Style x:Key="Ap.FaderFill" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" CornerRadius="3"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Ap.FaderEmpty" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Fader cap: brushed-metal look with a center line, like a mixing desk -->
            <Style x:Key="Ap.FaderCapV" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="38" Height="20" CornerRadius="3" BorderBrush="#111" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E4E4E9" Offset="0"/>
                                        <GradientStop Color="#B9B9C1" Offset="0.45"/>
                                        <GradientStop Color="#8E8E97" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Rectangle Height="2" Fill="#202024" Margin="4,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Ap.FaderCapH" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Width="12" Height="20" CornerRadius="2" BorderBrush="#111" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E4E4E9" Offset="0"/>
                                        <GradientStop Color="#9A9AA3" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Rectangle Width="2" Fill="#202024" Margin="0,3"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Vertical master fader with dB tick marks on both sides -->
            <Style x:Key="Ap.FaderV" TargetType="Slider">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Minimum" Value="-60"/>
                <Setter Property="Maximum" Value="0"/>
                <Setter Property="SmallChange" Value="0.5"/>
                <Setter Property="LargeChange" Value="3"/>
                <Setter Property="Ticks" Value="0,-6,-12,-18,-24,-36,-48,-60"/>
                <Setter Property="Foreground" Value="{StaticResource Ap.Main}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="10"/>
                                </Grid.ColumnDefinitions>
                                <TickBar Placement="Left" Fill="{StaticResource Ap.SubText}" Margin="0,0,2,0"
                                         Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Ticks="{TemplateBinding Ticks}"
                                         IsDirectionReversed="{TemplateBinding IsDirectionReversed}" ReservedSpace="20"/>
                                <Border Grid.Column="1" Width="8" CornerRadius="4" Background="#121216" BorderBrush="{StaticResource Ap.Line}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,10"/>
                                <Track x:Name="PART_Track" Grid.Column="1" Orientation="Vertical" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Ap.FaderFill}" Width="8" Margin="0,0,0,-10"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Ap.FaderEmpty}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Ap.FaderCapV}"/>
                                    </Track.Thumb>
                                </Track>
                                <TickBar Grid.Column="2" Placement="Right" Fill="{StaticResource Ap.SubText}" Margin="2,0,0,0"
                                         Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Ticks="{TemplateBinding Ticks}"
                                         IsDirectionReversed="{TemplateBinding IsDirectionReversed}" ReservedSpace="20"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slim horizontal fader for per-track volume -->
            <Style x:Key="Ap.FaderH" TargetType="Slider">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Minimum" Value="-60"/>
                <Setter Property="Maximum" Value="0"/>
                <Setter Property="SmallChange" Value="0.5"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Foreground" Value="#8A8A96"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="#121216" Margin="6,0"/>
                                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Ap.FaderFill}" Height="4" Margin="0,0,-6,0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Ap.FaderEmpty}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Ap.FaderCapH}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fade duration slider: 0–10 s in 0.1 s steps -->
            <Style x:Key="Ap.FadeSlider" TargetType="Slider" BasedOn="{StaticResource Ap.FaderH}">
                <Setter Property="Width" Value="84"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="10"/>
                <Setter Property="SmallChange" Value="0.1"/>
                <Setter Property="LargeChange" Value="0.5"/>
                <Setter Property="TickFrequency" Value="0.1"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="Foreground" Value="{StaticResource Ap.Cue}"/>
            </Style>

            <Style x:Key="Ap.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="#C62828"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="22,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
